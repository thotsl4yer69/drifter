[Unit]
Description=MZ1312 DRIFTER OBD-II ELM327 Bridge (serial / Bluetooth / Wi-Fi)
After=drifter-broker.target network.target bluetooth.target
Wants=drifter-broker.target
# Missing/disconnected vehicle hardware is a normal degraded condition.
# The bridge stays alive, publishes hw_pending and retries in-process.

[Service]
Type=simple
WorkingDirectory=/opt/drifter
ExecStart=/opt/drifter/venv/bin/python3 /opt/drifter/obd_bridge_multi.py
Restart=on-failure
RestartSec=15
Environment=PYTHONUNBUFFERED=1
# Supported ELM327 link settings:
#   DRIFTER_ELM_LINK=auto|serial|bluetooth|wifi
#   OBD_SERIAL_DEV=/dev/drifter-obd
#   OBD_SERIAL_BAUD=38400
#   ELM_BT_MAC=AA:BB:CC:DD:EE:FF
#   ELM_BT_CHANNEL=1
#   ELM_WIFI_HOST=192.168.0.10
#   ELM_WIFI_PORT=35000
EnvironmentFile=-/opt/drifter/.env

# Diagnostics/safety CORE tier.
MemoryMax=256M
OOMScoreAdjust=-800

# Bluetooth RFCOMM uses the host Bluetooth socket. RestrictAddressFamilies
# deliberately permits AF_BLUETOOTH alongside the existing local/network use.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_BLUETOOTH

# --- Hardening ------------------------------------------------------
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectSystem=full
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
