[Unit]
Description=MZ1312 DRIFTER Mesh (discovery)
After=drifter-broker.target network.target
# The coordinator and bridge are now their own supervised units, pulled up with
# this lane (they PartOf=drifter-mesh so stop/restart propagates). Previously
# they were backgrounded ExecStartPost `&` children — unsupervised, never
# restarted if they died, and orphaned on stop.
Wants=drifter-broker.target drifter-mesh-coordinator.service drifter-mesh-bridge.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/drifter
ExecStart=/opt/drifter/venv/bin/python3 /opt/drifter/mesh_discovery.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
