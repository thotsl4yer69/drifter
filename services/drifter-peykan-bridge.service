[Unit]
Description=DRIFTER optional Peykan MCP to MQTT evidence bridge
After=drifter-peykan-mcp.service drifter-broker.target
Requires=drifter-peykan-mcp.service
Wants=drifter-broker.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=drifter
Group=drifter
WorkingDirectory=/opt/drifter
EnvironmentFile=/opt/drifter/peykan.env
ExecStart=/opt/drifter/peykan-venv/bin/python3 /opt/drifter/peykan_bridge.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
MemoryMax=256M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
