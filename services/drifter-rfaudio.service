[Unit]
Description=MZ1312 DRIFTER rfaudio — on-demand RTL-SDR → speaker (emergency listen)
After=drifter-broker.target sound.target
Wants=drifter-broker.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=drifter
Group=drifter
SupplementaryGroups=audio plugdev
WorkingDirectory=/opt/drifter
# Wrapper preserves rfaudio's mature worker while adding the shared RTL-SDR lease.
ExecStart=/opt/drifter/venv/bin/python3 /opt/drifter/field_rfaudio.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/drifter

MemoryMax=384M
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/drifter/state
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
