[Unit]
Description=DRIFTER optional read-only Peykan MCP CAN server
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=drifter
Group=drifter
WorkingDirectory=/opt/drifter
EnvironmentFile=/opt/drifter/peykan.env
ExecStart=/opt/drifter/peykan-venv/bin/python3 /opt/drifter/peykan_server.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/drifter/peykan-logs
MemoryMax=384M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
