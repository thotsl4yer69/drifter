[Unit]
Description=MZ1312 DRIFTER 3.5" SPI LCD Dashboard
After=drifter-broker.target drifter-boot-manager.service
Wants=drifter-broker.target
# A field node must never permanently give up on the operator display after a
# burst of brownouts/controller resets. Restart=on-failure below still prevents
# clean-stop loops; disabling the start-rate limiter lets failed recovery keep
# retrying instead of leaving the panel white until the next power cycle.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/drifter
# Needs /dev/fb1 (video group) + GPIO buttons (gpio group) — runs as root so a
# fresh deploy works before group membership/udev settle. Override pins via env.
# Re-init the SPI panel before each start: if the panel/controller reset after a
# boot or power dip, re-binding fb_ili9486 re-sends the init sequence instead of
# leaving a physically white panel behind an apparently healthy framebuffer.
# LCD_SPI_DEVICE defaults to spi0.0 but may be overridden in /opt/drifter/.env.
# '-' = never block the dash if the device path differs; runs as root (no User=).
EnvironmentFile=-/opt/drifter/.env
ExecStartPre=-/bin/sh -c 'D=/sys/bus/spi/drivers/fb_ili9486; DEV=${LCD_SPI_DEVICE:-spi0.0}; echo "$DEV" > "$D/unbind" 2>/dev/null; sleep 0.3; echo "$DEV" > "$D/bind" 2>/dev/null; sleep 1'
# Wrapper keeps the mature renderer but removes CAN-specific empty-state text:
# ELM327, CAN and future OBD transports all get the same honest vehicle-link UI.
ExecStart=/opt/drifter/venv/bin/python3 /opt/drifter/field_lcd_dashboard.py
Restart=on-failure
RestartSec=5
# Diag-core dash service — negative OOMScoreAdjust protects the in-car triage
# console from global OOM kill so the operator keeps a screen under memory
# pressure (matches the other DIAG_SERVICES; heavy services sit at +500).
OOMScoreAdjust=-800
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
