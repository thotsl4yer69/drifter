[Unit]
Description=MZ1312 DRIFTER Web Dashboard & Audio Bridge
After=drifter-broker.target drifter-canbridge.service
Wants=drifter-broker.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=drifter
Group=drifter
SupplementaryGroups=audio plugdev
Type=simple
WorkingDirectory=/opt/drifter
# Field wrapper layers touch-first vehicle/RF/recovery routes over the mature
# dashboard and starts the passive RF operator engine in the same process.
ExecStart=/opt/drifter/venv/bin/python3 /opt/drifter/field_dashboard.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=DRIFTER_CORPUS_NO_EMBED=1

MemoryMax=512M
TasksMax=128
OOMScoreAdjust=-800

# Field routes use narrowly scoped sudoers entries for OBD selection, Bluetooth
# pairing, Wi-Fi ELM AP selection and display recovery. NoNewPrivileges must
# remain omitted or sudo -n is blocked.
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectSystem=full
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
