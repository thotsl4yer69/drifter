[Unit]
Description=MZ1312 DRIFTER Vehicle Identifier
After=drifter-broker.target
Wants=drifter-broker.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/drifter
ExecStart=/opt/drifter/venv/bin/python3 /opt/drifter/vehicle_id.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/drifter/.env
# Part of the diagnostics core (config.DIAG_SERVICES): it publishes the active
# vehicle profile every other diagnostic reads. Protect it from the global
# OOM-killer so a heavy service can't take the car's identity down with it.
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target
